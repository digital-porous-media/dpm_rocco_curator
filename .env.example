# LLM Provider Configuration
#
# IMPORTANT: All providers must expose an OpenAI-compatible API at /v1/chat/completions
# If your provider uses a different API format, you'll need to wrap it or use a proxy.
#
# Set LLM_PROVIDER as a shortcut OR set LLM_BASE_URL directly.
#
# Supported providers with built-in shortcuts (all OpenAI-compatible):
#   openai       -> https://api.openai.com/v1                    (default)
#   anthropic    -> https://api.anthropic.com/v1
#   gemini       -> https://generativelanguage.googleapis.com/v1beta/openai/
#   deepseek     -> https://api.deepseek.com/v1
#   huggingface  -> https://router.huggingface.co/v1      (instruction-tuned models only)
#   ollama       -> http://localhost:11434/v1                    (local)
#   sambanova    -> https://ai.tejas.tacc.utexas.edu/v1  (models: Qwen3-32B, Llama-4-Maverick-17B-128E-Instruct, Meta-Llama-3.3-70B-Instruct)
#
# For any other OpenAI-compatible endpoint, use openai_compatible and set LLM_BASE_URL
#
# Examples:
#   LLM_PROVIDER=openai
#   LLM_PROVIDER=anthropic
#   LLM_PROVIDER=ollama
#   LLM_PROVIDER=openai_compatible (then set LLM_BASE_URL below)
#
LLM_PROVIDER=openai

# API key for the chosen provider (required)
# For Ollama or local services, use dummy value like "ollama" or "unused"
LLM_API_KEY=your-api-key-here

# Custom endpoint URL (optional, overrides LLM_PROVIDER mapping)
# Example: http://localhost:8080/v1 (for self-hosted TGI)
# Example: https://custom-proxy.example.com/v1 (for wrapped proprietary APIs)
LLM_BASE_URL=

# Model name (optional, defaults to gpt-4o-mini)
# OpenAI: gpt-4o, gpt-4o-mini (recommended for cost)
# Anthropic: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4
# Gemini: gemini-2.0-flash, gemini-1.5-pro
# DeepSeek: deepseek-chat, deepseek-reasoner
# HuggingFace: meta-llama/Llama-3.1-8B-Instruct, mistralai/Mistral-7B-Instruct-v0.2 (instruction-tuned models only)
# Ollama: llama3, mistral, phi3, neural-chat, etc. (any locally pulled model)
# SambaNova (TACC): Qwen3-32B, Llama-4-Maverick-17B-128E-Instruct, Meta-Llama-3.3-70B-Instruct
LLM_MODEL=gpt-4o-mini

# Embedding model overrides (optional — auto-selected from LLM_PROVIDER when not set)
#
# Per-provider defaults applied automatically when these vars are absent:
#   openai      → text-embedding-3-small        (API)
#   sambanova   → E5-Mistral-7B-Instruct        (API, TACC endpoint, 4096-dim)
#   gemini      → gemini-embedding-2            (API)
#   ollama      → BAAI/bge-large-en-v1.5       (local, no key needed)
#   huggingface → BAAI/bge-large-en-v1.5       (local, no key needed)
#   anthropic   → BAAI/bge-large-en-v1.5       (local — Anthropic has no embedding API)
#   deepseek    → BAAI/bge-large-en-v1.5       (local — DeepSeek has no embedding API)
#   other       → BAAI/bge-large-en-v1.5       (local, safe default)
#
# Set any of these to override the provider default (e.g. use OpenAI embeddings with Anthropic LLM):
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Neo4j (required for dataset graph search — set USE_NEO4J=false to disable)
# Local: bolt://localhost:7687 | AuraDB: neo4j+s://<id>.databases.neo4j.io
USE_NEO4J=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# Semantic Scholar API (optional — unauthenticated requests work without a key,
# but a key gives a dedicated rate limit. Leave blank during development.)
SEMANTIC_SCHOLAR_API_KEY=
